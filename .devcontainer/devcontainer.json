{
  "name": "eclipse-s-core",
  "image": "ghcr.io/eclipse-score/devcontainer:v1.7.0",
  "runArgs": [
    "--device=/dev/kvm"
  ],
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {
      "moby": "false" // does not work with Debian Trixie based images
    }
  },
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],
  "postCreateCommand": "bash .devcontainer/prepare_workspace.sh",
  "postStartCommand": {
    "Add key to known_hosts": "ssh-keygen -f '/home/vscode/.ssh/known_hosts' -R '[localhost]:2222' || true",
    // should have been done by docker-in-docker feature
    "Make docker socket readable": "sudo chmod o+r /var/run/docker.sock",
    "Make docker socket writable": "sudo chmod o+w /var/run/docker.sock",
    "Make /dev/kvm readable and writable": "sudo chmod 666 /dev/kvm"
  }
}
